# Container versions are intentionally explicit for reproducible local development.
POSTGRES_VERSION=18.3
KAFKA_VERSION=4.3.1
ARTEMIS_VERSION=2.55.0-alpine

# Default capability set used by raw `docker compose up`.
COMPOSE_PROFILES=core

POSTGRES_PORT=5432
KAFKA_PORT=9092
ARTEMIS_CORE_PORT=61616
ARTEMIS_WEB_PORT=8161

POSTGRES_ADMIN_USER=dev_admin
POSTGRES_ADMIN_PASSWORD=__GENERATE__
DEV_DATABASE_PASSWORD=__GENERATE__

ARTEMIS_USER=dev_artemis
ARTEMIS_PASSWORD=__GENERATE__

# Format: database:owner,database:owner,...
DEV_DATABASES=catalog_db:catalog_app,orders_db:orders_app,billing_db:billing_app
